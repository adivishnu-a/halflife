{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,.next/**,ml/**,lib/**,app/**,content/**,public/**,.github/**,*.md}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 4 * * *"
    }
  ]
}
